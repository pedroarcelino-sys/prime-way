PRIMEWAY_DB_HOST=127.0.0.1
PRIMEWAY_DB_PORT=3306
PRIMEWAY_DB_NAME=primeway_school
PRIMEWAY_DB_USER=primeway_app
PRIMEWAY_DB_PASS=

# development local; definir production no servidor público.
PRIMEWAY_APP_ENV=development
# Em production o cookie Secure é obrigatório, inclusive atrás de proxy TLS.
PRIMEWAY_SESSION_SECURE=0
# CA exigida pelo provedor para MySQL remoto, com verificação de certificado.
PRIMEWAY_DB_SSL_CA=
# Produção: diretório absoluto, existente, gravável e fora da raiz pública.
PRIMEWAY_STORAGE_DIR=
# Conta de migrations separada, disponível somente durante atualização.
# PRIMEWAY_MIGRATION_DB_USER=primeway_migracao
# PRIMEWAY_MIGRATION_DB_PASS=
